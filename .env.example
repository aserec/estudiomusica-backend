# Copia este fichero a .env y ajusta los valores.
# Las variables se leen con pydantic-settings desde la raíz del repositorio
# (ruta absoluta; no dependen del directorio de trabajo).

# development | staging | production
APP_ENV=development

# Opt-in: incluir message en 500. Por defecto no se exponen.
EXPOSE_ERRORS=false

# Orígenes CORS permitidos (el frontend Next.js en local).
# Lista separada por comas. Con credenciales no se admite '*' ni esquemas que no sean http(s).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept

# Tamaño máximo del cuerpo (bytes). Por defecto 1 MiB.
MAX_BODY_BYTES=1048576

# Paginación page/pageSize. Los máximos evitan OFFSET enormes y pageSize sin tope.
PAGINATION_DEFAULT_PAGE=1
PAGINATION_DEFAULT_PAGE_SIZE=20
PAGINATION_MAX_PAGE=10000
PAGINATION_MAX_PAGE_SIZE=100

# /api/v1/examples solo se monta fuera de production, salvo override.
# ENABLE_EXAMPLE_ROUTES=true

# Postgres async (SQLAlchemy 2 + asyncpg). Coincide con docker-compose.yml.
# Fuera de APP_ENV=development hay que poner usuario, contraseña y base
# explícitos (no se heredan de PGUSER/PGPASSWORD/PGDATABASE). Se rechazan
# esta contraseña, este usuario (path o query) y cualquier base *_test
# (path o query, sin distinguir mayúsculas).
DATABASE_URL=postgresql+asyncpg://estudiomusica:estudiomusica@127.0.0.1:5432/estudiomusica
DB_HEALTH_TIMEOUT=2
DB_HEALTH_CACHE_TTL=1
DB_CONNECT_TIMEOUT=2
DB_COMMAND_TIMEOUT=5
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Opcional: DSN de la base de test (pytest). Si no se define, se usa
# la misma cuenta en la base `estudiomusica_test` que crea el compose.
# El nombre de la base debe terminar en `_test`. No uses ?database= / ?dbname=
# / ?service= / ?options= para apuntar a otra base.
# TEST_DATABASE_URL=postgresql+asyncpg://estudiomusica:estudiomusica@127.0.0.1:5432/estudiomusica_test
#
# Alembic de test se deriva de TEST_DATABASE_URL (`<stem>_alembic_test`).
# Solo hace falta override si quieres otra base (también debe terminar en `_test`).
# ALEMBIC_TEST_DATABASE_URL=postgresql+asyncpg://estudiomusica:estudiomusica@127.0.0.1:5432/estudiomusica_alembic_test
#
# En CI: fallar si Postgres no está, en vez de saltar los tests de BD.
# Acepta los booleanos de Pydantic (1/true/yes/on). Un valor desconocido aborta.
# REQUIRE_POSTGRES=1
#
# Tests TLS de ?sslrootcert= (fixture tls_postgres). Sin Docker, apunta a un
# Postgres TLS ya levantado o exige el fixture con REQUIRE_TLS_TESTS=1.
# TLS_TEST_DATABASE_URL=postgresql+asyncpg://tlsprobe:tlsprobe-secret@127.0.0.1:55433/tlsprobe_test
# TLS_TEST_CAFILE=/ruta/al/ca.pem
# REQUIRE_TLS_TESTS=1

# JWT HS256 de la cookie de sesión. Fuera de development se rechaza este
# valor por defecto y se exigen al menos 32 caracteres.
AUTH_SECRET=dev-insecure-auth-secret-change-me
AUTH_COOKIE_NAME=session
# 7 días
AUTH_SESSION_TTL_SECONDS=604800
# Emails que, al registrarse, salen como admin. Lista separada por comas.
BOOTSTRAP_ADMIN_EMAILS=
# Coste de argon2. Los tests usan valores más bajos.
# AUTH_ARGON2_TIME_COST=3
# AUTH_ARGON2_MEMORY_COST=65536
# AUTH_ARGON2_PARALLELISM=4
